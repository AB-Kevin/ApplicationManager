{
  "name": "applicationmanager-file-manager",
  "version": "0.2.3",
  "description": "ApplicationManager - a holding space and member tracker for Member Applications",
  "main": "main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.applicationmanager.filemanager",
    "productName": "ApplicationManager",
    "files": [
      "main.js",
      "preload.js",
      "application-pdf.js",
      "tracker-xlsx.js",
      "assets/**/*",
      "renderer/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "ApplicationManager-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "AB-Kevin",
      "repo": "ApplicationManager",
      "releaseType": "release"
    }
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "electron-winstaller@5.4.0": true
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "exiftool-vendored": "^37.1.0",
    "pdf-lib": "^1.17.1"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
